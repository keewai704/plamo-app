# Copy to ~/.config/plamo-server/config.env. Environment variables take precedence.

# Seconds without requests before the weights are released from memory.
# 0 keeps them loaded forever. The next request loads them again. llama.cpp only;
# vLLM keeps the weights loaded until it stops.
PLAMO_IDLE_SECONDS=600

# Bearer token; required unless the server listens on loopback only.
#PLAMO_API_KEY=

#PLAMO_HOST=127.0.0.1
#PLAMO_PORT=8000
#PLAMO_GPU_LAYERS=
# Fraction of the GPU memory that vLLM reserves.
#PLAMO_GPU_MEMORY=0.25
#PLAMO_MODEL_DIR=
